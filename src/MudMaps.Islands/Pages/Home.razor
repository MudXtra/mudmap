@page "/"
@inherits MapPageBase

<PageTitle>The Mud Archipelago</PageTitle>

<div class="mm-wrap">
    @if (Data is null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate Class="mt-8" />
    }
    else
    {
        <span class="mm-stamp">Chart no. 1, November</span>
        <MapHero Title="The Mud Archipelago"
                 Lede="Every island is a part of the code. Red flags fly where this month’s pull requests landed."
                 Figures="Figures" />

        <ZoomTrail Steps="Trail" />

        <div class="mm-stage mt-2">
            <svg @ref="Svg" viewBox="@($"0 0 {F(ViewWidth)} {F(ViewHeight)}")" role="img" aria-label="Sea chart of the Mud repositories">
                <defs>
                    <pattern id="half" width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="4.5" cy="4.5" r="1.3" fill="var(--blue)" opacity=".55" /></pattern>
                    <pattern id="land" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r=".9" fill="var(--ink)" opacity=".35" /></pattern>
                </defs>
                <rect x="-800" y="-800" width="3200" height="2600" fill="var(--paper)" />
                <rect x="-800" y="-800" width="3200" height="2600" fill="url(#half)" />
                @for (var x = 100; x < 1600; x += 100)
                {
                    <line x1="@x" y1="-800" x2="@x" y2="1800" stroke="var(--blue)" stroke-width=".6" opacity=".35" />
                }
                @for (var y = 100; y < 1000; y += 100)
                {
                    <line x1="-800" y1="@y" x2="2400" y2="@y" stroke="var(--blue)" stroke-width=".6" opacity=".35" />
                }

                <g class="lab" style="@LabelStyle" pointer-events="none">
                    <text x="780" y="120" text-anchor="middle" font-family="Newsreader, serif" font-style="italic" font-size="24" fill="var(--blue)">The Razor Strait</text>
                    <circle cx="1520" cy="100" r="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
                    @for (var i = 0; i < 8; i++)
                    {
                        var a = i * Math.PI / 4;
                        var l = i % 2 == 1 ? 24 : 40;
                        <path d="@($"M1520,100 L{F(1520 + Math.Cos(a - .12) * 10)},{F(100 + Math.Sin(a - .12) * 10)} L{F(1520 + Math.Cos(a) * l)},{F(100 + Math.Sin(a) * l)} Z")"
                              fill="@(i % 2 == 1 ? "var(--blue)" : "var(--red)")" />
                    }
                    <text x="1520" y="48" text-anchor="middle" font-family="Anton, sans-serif" font-size="16" fill="var(--ink)">N</text>
                </g>

                @foreach (var r in _routes)
                {
                    <path class="lab" style="@LabelStyle" d="@r.Path" fill="none" stroke="@(r.Cross ? "var(--red)" : "var(--ink)")"
                          stroke-width="@F(r.Width)" stroke-dasharray="6 5" opacity=".75" />
                }

                @foreach (var i in _islands)
                {
                    <g class="area mm-hot" style="@AreaStyle(i.Hood)" tabindex="0" role="button"
                       aria-label="@($"{i.Hood.Label} in {i.Hood.Repo}, {i.Hood.Prs} pull requests. Land here.")"
                       @onclick="() => OpenHoodAsync(i.Hood)" @onkeydown="e => KeyAsync(e, () => OpenHoodAsync(i.Hood))">
                        <path d="@i.Shore" fill="var(--paper)" stroke="var(--blue)" stroke-width="1.2" />
                        <path d="@i.Coast" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2" />
                        <path d="@i.Coast" fill="url(#land)" />
                        @foreach (var ring in i.Rings)
                        {
                            <path d="@ring" fill="none" stroke="var(--ink)" stroke-width=".9" opacity=".6" />
                        }
                        @foreach (var f in CurrentHood is null ? i.Flags : [])
                        {
                            <line x1="@F(f.X)" y1="@F(f.Y)" x2="@F(f.X)" y2="@F(f.Y - 16)" stroke="var(--ink)" stroke-width="1.5" />
                            <path d="@($"M{F(f.X)},{F(f.Y - 16)} l10,4 l-10,4z")" fill="var(--red)" />
                        }
                        <title>@($"{i.Hood.Label}: {i.Hood.Prs} pull requests")</title>
                    </g>
                }

                @foreach (var i in _islands)
                {
                    <g class="lab" style="@LabelStyle" pointer-events="none">
                        <text x="@F(i.X)" y="@F(i.Y + i.R * Squash * 1.25 + 14)" text-anchor="middle" font-family="Anton, sans-serif"
                              font-size="@(i.R > 40 ? "17" : "13")" fill="var(--ink)" paint-order="stroke" stroke="var(--paper)" stroke-width="4">@i.Hood.Label.ToUpperInvariant()</text>
                        @if (i.Hood.Prs > 0)
                        {
                            <g><text x="@F(i.X)" y="@F(i.Y + i.R * Squash * 1.25 + 27)" text-anchor="middle" font-family="IBM Plex Mono, monospace"
                                  font-size="10" letter-spacing="1" fill="var(--red)" paint-order="stroke" stroke="var(--paper)" stroke-width="3">@($"{i.Hood.Prs} FLAGS")</text></g>
                        }
                    </g>
                }

                @foreach (var g in _groups)
                {
                    <g class="lab mm-hot" style="@LabelStyle" tabindex="0" role="button" aria-label="@($"{g.Repo}: {g.Prs} pull requests. Details.")"
                       @onclick="() => OpenRepo(g.Repo)" @onkeydown="e => KeyAsync(e, () => { OpenRepo(g.Repo); return Task.CompletedTask; })">
                        <text x="@F(g.X)" y="@F(g.Y)" text-anchor="middle" font-family="Newsreader, serif" font-style="italic" font-size="20"
                              fill="var(--blue)" paint-order="stroke" stroke="var(--paper)" stroke-width="5">@g.Repo</text>
                    </g>
                }

                @if (CurrentHood is not null)
                {
                    foreach (var room in Rooms)
                    {
                        var hot = room.Cluster.Prs > 0;
                        <g class="mm-hot" tabindex="0" role="button" aria-label="@($"{room.FullName}, {room.Cluster.N} code items, {room.Cluster.Prs} pull requests")"
                           @onclick="() => OpenRoom(room)" @onkeydown="e => KeyAsync(e, () => { OpenRoom(room); return Task.CompletedTask; })">
                            <rect x="@F(room.X - room.R * 1.2)" y="@F(room.Y - room.R * .62)" width="@F(room.R * 2.4)" height="@F(room.R * 1.24)"
                                  fill="@(hot ? "var(--red)" : "var(--paper)")" stroke="var(--ink)" stroke-width="@F(room.R * (CurrentRoom == room.Cluster ? .1 : .05))" />
                            <text x="@F(room.X)" y="@F(room.Y + room.FontSize * .35)" text-anchor="middle" font-family="IBM Plex Mono, monospace"
                                  font-size="@F(room.FontSize * .72)" fill="@(hot ? "var(--paper)" : "var(--ink)")">@room.Name</text>
                            <title>@room.FullName</title>
                        </g>
                    }
                }
            </svg>
        </div>
        <MapControls IncludeTests="IncludeTests" IncludeTestsChanged="SetIncludeTestsAsync" Available="TestsKnown" TestItems="TestItems" />
        <MapSheet Room="CurrentRoom" Repo="CurrentRepo" RoomRepo="RepoOf(CurrentRoom)" WindowDays="Data.WindowDays" OnClose="CloseDetails" />

        <div class="mm-colophon"><span>Surveyed from the Graphify maps and GitHub, last @Data.WindowDays days</span><span>Printed in two inks</span></div>
        <MudText Typo="Typo.body2" Class="mm-note">
            Click an island to land and see its villages, the rooms of its code; red ones had pull requests this month. Click a village for its code,
            a blue sea name for the repo. Dashed routes are calls between areas; red routes cross from one repo to another.
        </MudText>
    }
</div>
