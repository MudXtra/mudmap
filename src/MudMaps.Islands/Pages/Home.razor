@page "/"
@inherits MapPageBase

<PageTitle>The Mud Archipelago</PageTitle>

<div class="mm-wrap">
    @if (Data is null)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate Class="mt-8" />
    }
    else
    {
        <span class="mm-stamp">Chart no. 1, November</span>
        <MapHero Title="The Mud Archipelago"
                 Lede="Every island is a part of the code. Red flags fly where this month’s pull requests landed."
                 Figures="Figures">
            <Nav><MapNav Current="islands" /></Nav>
        </MapHero>

        <ZoomTrail Steps="Trail" />

        <div class="mm-stage mt-2">
            <svg @ref="Svg" viewBox="@($"0 0 {F(ViewWidth)} {F(ViewHeight)}")" role="img" aria-label="Sea chart of the Mud repositories">
                <defs>
                    <pattern id="half" width="9" height="9" patternUnits="userSpaceOnUse"><circle cx="4.5" cy="4.5" r="1.3" fill="var(--blue)" opacity=".55" /></pattern>
                    <pattern id="land" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r=".9" fill="var(--ink)" opacity=".35" /></pattern>
                </defs>
                <rect x="-800" y="-800" width="3200" height="3000" fill="var(--paper)" />
                <rect x="-800" y="-800" width="3200" height="3000" fill="url(#half)" style="@(CurrentHood is null ? null : "cursor:zoom-out")" @onclick="BackgroundAsync" />
                @for (var x = 100; x < 1600; x += 100)
                {
                    <line x1="@x" y1="-800" x2="@x" y2="2200" stroke="var(--blue)" stroke-width=".6" opacity=".35" />
                }
                @for (var y = 100; y < ViewHeight; y += 100)
                {
                    <line x1="-800" y1="@y" x2="2400" y2="@y" stroke="var(--blue)" stroke-width=".6" opacity=".35" />
                }

                <g class="waves" pointer-events="none" aria-hidden="true">
                    @foreach (var (wy, w) in WaveRows.Select((y, k) => (y, k)))
                    {
                        <path class="wave" style="@($"animation-delay: -{F(w * 2.7)}s")" d="@($"M-800,{F(wy)} q25,-12 50,0{string.Concat(Enumerable.Repeat(" t50,0", 63))}")"
                              fill="none" stroke="var(--blue)" stroke-width="2" opacity=".45" />
                    }
                </g>

                <g class="lab" style="@LabelStyle" pointer-events="none">
                    <text x="780" y="120" text-anchor="middle" font-family="Newsreader, serif" font-style="italic" font-size="26" fill="var(--blue)">The Razor Strait</text>
                    <circle cx="1520" cy="100" r="44" fill="var(--paper)" stroke="var(--ink)" stroke-width="2" />
                    @for (var i = 0; i < 8; i++)
                    {
                        var a = i * Math.PI / 4;
                        var l = i % 2 == 1 ? 24 : 40;
                        <path d="@($"M1520,100 L{F(1520 + Math.Cos(a - .12) * 10)},{F(100 + Math.Sin(a - .12) * 10)} L{F(1520 + Math.Cos(a) * l)},{F(100 + Math.Sin(a) * l)} Z")"
                              fill="@(i % 2 == 1 ? "var(--blue)" : "var(--red)")" />
                    }
                    <text x="1520" y="48" text-anchor="middle" font-family="Anton, sans-serif" font-size="18" fill="var(--ink)">N</text>
                    <g transform="translate(1520,100)">
                        <g class="compass-needle">
                            <path d="M0,-40 L8,0 L0,40 L-8,0 Z" fill="var(--red)" />
                            <path d="M0,-30 L5,0 L0,30 L-5,0 Z" fill="var(--blue)" />
                        </g>
                    </g>
                </g>

                @foreach (var r in _routes)
                {
                    <path class="lab" style="@LabelStyle" d="@r.Path" fill="none" stroke="@(r.Cross ? "var(--red)" : "var(--ink)")"
                          stroke-width="@F(r.Width)" stroke-dasharray="6 5" opacity=".75" />
                }

                @foreach (var i in _islands)
                {
                    <g class="area mm-hot mm-pop" data-hood="@i.Hood.Key" style="@AreaStyle(i.Hood)" tabindex="0" role="button"
                       aria-label="@($"{i.Hood.Label} in {i.Hood.Repo}, {i.Hood.Prs} pull requests. Land here.")"
                       @onclick="() => LandAsync(i.Hood)" @onkeydown="e => KeyAsync(e, () => LandAsync(i.Hood))">
                        <path d="@i.Shore" fill="var(--paper)" stroke="var(--blue)" stroke-width="1.2" />
                        <path d="@i.Coast" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="2" />
                        <path d="@i.Coast" fill="url(#land)" />
                        @foreach (var ring in i.Rings)
                        {
                            <path d="@ring" fill="none" stroke="var(--ink)" stroke-width=".9" opacity=".6" />
                        }
                        @foreach (var f in CurrentHood is null ? i.Flags : [])
                        {
                            <g class="flag">
                                <line x1="@F(f.X)" y1="@F(f.Y)" x2="@F(f.X)" y2="@F(f.Y - 16)" stroke="var(--ink)" stroke-width="1.5" />
                                <path d="@($"M{F(f.X)},{F(f.Y - 16)} l10,4 l-10,4z")" fill="var(--red)" />
                            </g>
                        }
                        <title>@($"{i.Hood.Label}: {i.Hood.Prs} pull requests")</title>
                    </g>
                }

                <g class="lab harbour" style="@LabelStyle" pointer-events="none" aria-hidden="true" transform="@($"translate({F(HarbourMark.X)},{F(HarbourMark.Y)})")">
                    <path d="M-58,30 Q-50,8 -22,10 L-22,18 Q-44,18 -48,32 Z" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="1.6" />
                    <path d="M58,30 Q50,8 22,10 L22,18 Q44,18 48,32 Z" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="1.6" />
                    <path d="M-22,10 L22,10 L22,18 L-22,18 Z" fill="var(--paper-2)" stroke="var(--ink)" stroke-width="1.6" />
                    <path d="M-6,10 L-4,-26 L4,-26 L6,10 Z" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.6" />
                    <path d="M-5.4,-2 L5.4,-2 L5.8,4 L-5.8,4 Z M-4.6,-16 L4.6,-16 L5,-10 L-5,-10 Z" fill="var(--red)" />
                    <path d="M-6,-26 L6,-26 L0,-34 Z" fill="var(--ink)" />
                    <circle class="beam" cx="0" cy="-22" r="3" fill="var(--red)" />
                    <text x="0" y="52" text-anchor="middle" font-family="Newsreader, serif" font-style="italic" font-size="@F(RepoSize - 1)" fill="var(--blue)"
                          paint-order="stroke" stroke="var(--paper)" stroke-width="5">Home port</text>
                </g>

                @foreach (var i in _islands.Where(i => i.Tag is not null))
                {
                    var tag = i.Tag!;
                    <g class="lab tag @(CurrentHood is null ? "mm-hot" : "")" style="@LabelStyle" pointer-events="@(CurrentHood is null ? "auto" : "none")"
                       tabindex="@(CurrentHood is null ? 0 : -1)" role="button"
                       aria-label="@($"{i.Hood.Label} in {i.Hood.Repo}, {i.Hood.Prs} pull requests. Sail to this island.")"
                       @onclick="() => LandAsync(i.Hood)" @onkeydown="e => KeyAsync(e, () => LandAsync(i.Hood))">
                        @if (tag.Leader is { } leader)
                        {
                            <path d="@leader" stroke="var(--ink)" stroke-width="1" fill="none" opacity=".7" />
                        }
                        <rect x="@F(tag.Box.X - 2)" y="@F(tag.Box.Y)" width="@F(tag.Box.W + 4)" height="@F(tag.Box.H)" fill="transparent" />
                        <text x="@F(tag.X)" y="@F(tag.Baseline)" font-family="Newsreader, serif" font-weight="600" font-size="@F(NameSize)" fill="var(--ink)"
                              paint-order="stroke" stroke="var(--paper)" stroke-width="5" stroke-linejoin="round">
                            @tag.Name
                            @if (tag.Count is { } count)
                            {
                                <tspan dx="6" font-weight="500" font-style="italic" font-size="@F(CountSize)" fill="var(--red-ink)">@count</tspan>
                            }
                        </text>
                        <title>@($"{i.Hood.Label}: {i.Hood.Prs} pull requests")</title>
                    </g>
                }

                @foreach (var g in _groups)
                {
                    <g class="lab @(CurrentHood is null ? "mm-hot mm-pop" : "")" style="@LabelStyle" pointer-events="@(CurrentHood is null ? "auto" : "none")"
                       tabindex="@(CurrentHood is null ? 0 : -1)" role="button" aria-label="@($"{g.Repo}: {g.Prs} pull requests. Details.")"
                       @onclick="() => OpenRepo(g.Repo)" @onkeydown="e => KeyAsync(e, () => { OpenRepo(g.Repo); return Task.CompletedTask; })">
                        <text x="@F(g.X)" y="@F(g.Y)" text-anchor="middle" font-family="Newsreader, serif" font-style="italic" font-weight="600" font-size="@F(RepoSize)"
                              fill="var(--blue)" paint-order="stroke" stroke="var(--paper)" stroke-width="6" stroke-linejoin="round">@Fit.Cut(g.Repo, 24)</text>
                        <title>@g.Repo</title>
                    </g>
                }

                @if (CurrentHood is not null)
                {
                    foreach (var room in Rooms)
                    {
                        var hot = room.Cluster.Prs > 0;
                        <g class="mm-hot" tabindex="0" role="button" aria-label="@($"{room.FullName}, {room.Cluster.N} code items, {room.Cluster.Prs} pull requests")"
                           @onclick="() => OpenRoom(room)" @onkeydown="e => KeyAsync(e, () => { OpenRoom(room); return Task.CompletedTask; })">
                            <rect x="@F(room.X - room.R * 1.2)" y="@F(room.Y - room.R * .62)" width="@F(room.R * 2.4)" height="@F(room.R * 1.24)"
                                  fill="@(hot ? "var(--red)" : "var(--paper)")" stroke="var(--ink)" stroke-width="@F(room.R * (CurrentRoom == room.Cluster ? .1 : .05))" />
                            <title>@room.FullName</title>
                        </g>
                    }
                    @* Village names go on after every box, so a neighbouring box can never cover a name. The module sets them at a
                       readable screen size, on one or two lines cut to the box; the full name is in each box's title and the sheet. *@
                    foreach (var room in Rooms)
                    {
                        var hot = room.Cluster.Prs > 0;
                        <g>
                            <text class="village" x="@F(room.X)" y="@F(room.Y)" data-name="@VillageName(room.FullName)" data-w="@F(Math.Max(room.R * 2.4, VillagePitch * .98))" data-h="@F(room.R * 1.24)"
                                  text-anchor="middle" font-family="Newsreader, serif" font-weight="600" fill="@(hot ? "var(--paper)" : "var(--ink)")"
                                  paint-order="stroke" stroke="@(hot ? "var(--red)" : "var(--paper)")" stroke-linejoin="round"
                                  pointer-events="none" aria-hidden="true"></text>
                        </g>
                    }
                }
            </svg>
        </div>
        <MapControls IncludeTests="IncludeTests" IncludeTestsChanged="SetIncludeTestsAsync" Available="TestsKnown" TestItems="TestItems" />
        <MapSheet Room="CurrentRoom" Repo="CurrentRepo" RoomRepo="RepoOf(CurrentRoom)" WindowDays="Data.WindowDays" OnClose="CloseDetails" />

        <div class="mm-colophon"><span>Surveyed from the Graphify maps and GitHub, last @Data.WindowDays days</span><span>Printed in two inks</span></div>
        <MudText Typo="Typo.body1" Class="mm-note">
            Click an island to sail there from the home port and land among its villages, the rooms of its code; red ones had pull requests this month.
            Click a village for its code, a blue sea name for the repo, or open water to sail home. Dashed routes are calls between areas; red routes cross from one repo to another.
        </MudText>
    }
</div>
